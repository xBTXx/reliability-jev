TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional OpenRouter provider pin; no fallback to other providers.
TEXT_MODEL_PROVIDER=
# To try DeepSeek Flash on Together using the same OpenRouter key:
# TEXT_MODEL=deepseek/deepseek-v4.1-flash
# TEXT_MODEL_PROVIDER=together
