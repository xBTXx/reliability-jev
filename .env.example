TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional USD/input-million override for custom/future Jev pricing.
# Defaults for jev-1.14.0 and jev-1.13.0: $0.042/M input; output free (checked 2026-10-30).
# TYPESAFE_INPUT_USD_PER_MILLION=0.042
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# GPT-OSS always reasons: none is adapted to low and recorded; explicit low is preferred.
# TEXT_MODEL_MAX_TOKENS=2048  # Default: 1024 when reasoning is off, otherwise 2048.
# Optional OpenRouter provider pin; no fallback to other providers.
TEXT_MODEL_PROVIDER=
# To try DeepSeek Flash on Together using the same OpenRouter key:
# TEXT_MODEL=deepseek/deepseek-v4.1-flash
# TEXT_MODEL_PROVIDER=together

# Reasoning supervisor: model/endpoint/key inherit TEXT_MODEL settings when omitted.
# Reasoning is always enabled here, independent of TEXT_MODEL_REASONING=none.
# Use a reasoning-capable model (the local setup already uses DeepSeek Flash).
SUPERVISOR_MODEL=deepseek/deepseek-v4.1-flash
# SUPERVISOR_MODEL_BASE_URL=https://openrouter.ai/api/v1
# SUPERVISOR_MODEL_API_KEY=
# SUPERVISOR_MODEL_PROVIDER=together
SUPERVISOR_MAX_TOKENS=8192
SUPERVISOR_TIMEOUT=90
# Optional provider-supported effort; default enables reasoning at the provider's default effort.
# SUPERVISOR_REASONING_EFFORT=low
